# Copia este archivo a .env y completa GOOGLE_API_KEY. NUNCA subas el .env (ya está en .gitignore).

# --- LLM de chat: Gemini (capa gratuita de Google AI Studio) ---
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
# Copia el id exacto desde Google AI Studio: los modelos gratuitos cambian con el tiempo.
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MAX_RETRIES=6

# --- Embeddings (siguen en Ollama; ejecuta antes: ollama pull bge-m3) ---
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# --- Redis (redis-stack: necesita RedisJSON + RediSearch) ---
REDIS_URL=redis://localhost:6379/0

# --- Arize Phoenix ---
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=huerta-viva-agentes
# Solo si activas la autenticación de Phoenix: crea una System API key en su UI y pégala aquí.
# (Con el docker-compose.yml de este repo NO hace falta: la autenticación va desactivada.)
# PHOENIX_API_KEY=

# --- Worker ---
MAX_CONCURRENT_JOBS=5
